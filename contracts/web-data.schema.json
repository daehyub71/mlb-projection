              "type": "integer"
            },
            "ran_at": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
            },
            "params_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "reruns": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
