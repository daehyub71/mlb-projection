                ],
                "properties": {
                  "ran_at": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvalRow"
          }
        },
        "bands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BandRow"
          }
        }
      }
    },
    "BandRow": {
      "description": "one past-error band (SPEC D29): 80th percentile of |projection - actual| of the final model",
      "type": "object",
